# Скопируй этот файл в .env и вставь свои ключи:
#     cp .env.example .env

# Голос персонажа — ключ Fish Audio.
# Взять: https://fish.audio/ru/app/developers/  →  «Создать API-ключ»
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free

# ----------------------------------- «мозги» разговора, по приоритету -----
# Задан только один ключ? Работает он. Заданы несколько — используется
# верхний по списку, остальные — как запасной вариант при сбое.

# 1. Anthropic — платный, лучшее качество диалога.
# Взять: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 2. Groq — бесплатный, отвечает за доли секунды (свои LPU-чипы вместо
# общих GPU в очереди). РЕКОМЕНДУЕТСЯ, если важна скорость ответа.
# Взять: https://console.groq.com/keys — регистрация, без карты, 1 минута.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. NVIDIA NIM — тоже бесплатный, но на общем тарифе очередь: 11-18 секунд
# на ответ даже без нагрузки. Держим как запасной вариант, не основной.
# Взять: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Ни одного ключа не задано — работает локальный банк фраз по ключевым
# словам (brain.js). Мгновенно, но не настоящий диалог.

# Необязательно: свой голос из библиотеки fish.audio.
# ID берётся из адреса страницы голоса: fish.audio/ru/app/m/<ID>/
# FISH_VOICE_ID_MCQUEEN=
# FISH_VOICE_ID_MATER=
# FISH_VOICE_ID_DOC=

# Порты (HTTPS нужен, чтобы микрофон работал на телефоне в той же Wi-Fi)
PORT=3000
HTTPS_PORT=3443
