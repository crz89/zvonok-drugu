# ============================================================ СЕКРЕТЫ
# Живые ключи Fish Audio / Groq / NVIDIA. В публичный репозиторий — никогда:
# утёкший ключ находят боты за минуты и тратят твои деньги.
.env
.env.local
.env.*.local
# .env.example остаётся в репозитории — это шаблон без ключей.
!.env.example

# Настройки Claude Code: внутри осели ключи из прошлых curl-команд.
.claude/

# Самоподписанные сертификаты для локального HTTPS — у каждого свои.
.certs/

# ======================================================= ЧУЖИЕ ПРОЕКТЫ
# Отдельный проект, к «Звонку другу» отношения не имеет.
kasap-agent/
for-flux/

# ============================================================== МУСОР
node_modules/
.DS_Store
*.log
